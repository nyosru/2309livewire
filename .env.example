APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost


NOMINATIM_URL=https://nominatim.openstreetmap.org

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

BLOG_API_KEY=
sercret=

# парроль для раал.рф
PASS_FOR_RAAL=

# Вкусняжки72: серверные учётные записи суперадминистратора
VKUSNO_SUPER_ADMIN_VK_ID=
VKUSNO_SUPER_ADMIN_PHONE=
# Далее — только исходные значения для миграции 2026_10_23_000006.
# После миграции контакты и параметры редактируются в /admin/settings.
VKUSNO_PHONE=
VKUSNO_ADDRESS=
VKUSNO_HOURS=
VKUSNO_DEMO_MENU=true
# Пустое значение: стоимость доставки согласуется с клиентом
VKUSNO_DELIVERY_FEE=null
# Версия в адресе фотографий товаров (?date=...): менять при замене картинок,
# чтобы браузер не отдавал старые файлы из кеша. По умолчанию — 20261025.
VKUSNO_IMAGE_CACHE_VERSION=20261025

# MAX: параметры бота импортируются в БД при миграции 2026_10_23_000006.
# После миграции редактируются в /admin/settings; .env больше не переопределяет их.
# MAX_CA_BUNDLE и MAX_AUTH_SERVICE_CLIENTS остаются серверными настройками.
MAX_BOT_TOKEN=
MAX_CA_BUNDLE=resources/certs/max-russian-trusted-root.pem
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_URL=
# bot — коды через собственного бота, если это предусмотрено договором с MAX
MAX_AUTH_DRIVER=disabled
# Необязательно: ключи независимых серверных проектов, каждый не короче 32 символов
MAX_AUTH_SERVICE_CLIENTS={}
